# =============================================================================
# Frontend Production Environment Variables
# =============================================================================
# ⚠️  DO NOT commit this file with real values!
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
#
# After running `terraform apply`, get these values from:
#   terraform output alb_dns_name
#   terraform output vercel_env_snippet
# =============================================================================

# Replace with your ALB DNS name from: terraform output alb_dns_name
VITE_API_BASE_URL=http://YOUR-ALB-DNS-NAME.ap-south-1.elb.amazonaws.com

# WebSocket base URL (same host, ws:// protocol)
VITE_WS_BASE_URL=ws://YOUR-ALB-DNS-NAME.ap-south-1.elb.amazonaws.com
